#!/usr/bin/env ruby

require "json"

url = ARGV.first
brave_cmd = "brave --password-store=basic --enable-features=UseOzonePlatform --ozone-platform=wayland"

current_workspace = JSON.parse(`hyprctl activeworkspace -j`)
windows = JSON.parse(`hyprctl clients -j`)
brave_windows = windows.select { |window| window["class"] == "brave-browser" }

brave_found_on_current_workspace = brave_windows.one? do |brave|
  brave.dig("workspace", "id") == current_workspace["id"]
end

brave_cmd += " --new-window" unless brave_found_on_current_workspace

`hyprctl dispatch exec "#{brave_cmd} #{url}"`
