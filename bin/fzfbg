#!/usr/bin/env ruby

require "fileutils"
require 'open3'

ASSETS = "#{ENV["DOTFILES"]}/assets"

filenames = Dir.glob("#{ASSETS}/*").map { |filename| filename.split('/').last.split('.').first }
stdin_data = filenames.join("\n")

stdout, _, status = Open3.capture3('fzf', stdin_data:)
exit unless status.success?

selected_filename = stdout.strip
file = "#{ASSETS}/#{selected_filename}.png"

# Set hyprpaper's wallpaper
target = "#{Dir.home}/.config/wallpaper.png"
FileUtils.copy(file, target)
`hyprctl hyprpaper reload ",#{target}" > /dev/null`

# Create blurry version for overlays like hyprlock/rofi
blurry_target = "#{Dir.home}/.config/blurry_wallpaper.png"

layer_color = "#1e1e1ecc"
size = `identify -format "%wx%h" #{file}`.strip
options = [
  ["compose", "over"],
  ["composite"],
  ["blur", "0x4"]
].map { |option| "-#{option.join(" ")}" }.join(" ")

`magick #{file} \\( -size "#{size}" xc:"#{layer_color}" \\) #{options} #{blurry_target}`

# Use blurry version for sddm
sddm_target = "/usr/share/sddm/themes/joenn/assets/background.png"
`sudo cp #{blurry_target} #{sddm_target}`

puts "Wallpaper changed to #{selected_filename}."
