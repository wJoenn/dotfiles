#!/bin/zsh

TODAY=$(date +%Y-%m-%d)
YAY_UPDATE_TIMESTAMP="$HOME/.yay_update_timestamp"

if [ -f "$YAY_UPDATE_TIMESTAMP" ] && [ $(cat "$YAY_UPDATE_TIMESTAMP") = $TODAY ]; then
  return
fi

ASCII_ART="
█████ █████                                 █████████
░░███ ░░███                                 ███░░░░░███
 ░░███ ███    ██████   █████ ████          ░███    ░░░  █████ ████ █████ ████
  ░░█████    ░░░░░███ ░░███ ░███     ██████░░█████████ ░░███ ░███ ░░███ ░███
   ░░███      ███████  ░███ ░███    ░░░░░░  ░░░░░░░░███ ░███ ░███  ░███ ░███
    ░███     ███░░███  ░███ ░███            ███    ░███ ░███ ░███  ░███ ░███
    █████   ░░████████ ░░███████           ░░█████████  ░░███████  ░░████████
   ░░░░░     ░░░░░░░░   ░░░░░███            ░░░░░░░░░    ░░░░░███   ░░░░░░░░
                        ███ ░███                         ███ ░███
                       ░░██████                         ░░██████
                        ░░░░░░                           ░░░░░░
"

# Python script for generating the gradient
# This script is self-contained within the bash script using a "heredoc"
python3 -c "
import sys

# Define start and end colors
start_color = [128, 238, 192]  # #80eec0
end_color = [0, 122, 204]    # #007acc

# Split the ASCII art into lines
lines = sys.stdin.read().splitlines()
num_lines = len(lines)
max_len = max(len(line) for line in lines)

# Iterate through each character and apply the gradient
for y, line in enumerate(lines):
    output_line = ''
    line_len = len(line)
    for x, char in enumerate(line):
        # Calculate the position in the gradient
        # We consider both X and Y axes for the bottom-right gradient
        # The weight of X and Y can be adjusted to change the gradient's angle
        ratio = ((x / (max_len - 1)) + (y / (num_lines - 1))) / 2

        # Linear interpolation for each color channel (R, G, B)
        r = int(start_color[0] + (end_color[0] - start_color[0]) * ratio)
        g = int(start_color[1] + (end_color[1] - start_color[1]) * ratio)
        b = int(start_color[2] + (end_color[2] - start_color[2]) * ratio)

        # Print the character with the interpolated color using ANSI escape codes
        output_line += f'\033[38;2;{r};{g};{b}m{char}\033[0m'

    print(output_line)
" <<< $ASCII_ART

echo "Do you want to run \`yay -Syu\` ? (y/n)"
read -r -k 1
echo

echo $TODAY > $YAY_UPDATE_TIMESTAMP
if [[ $REPLY = "y" ]]; then
  yay -Syu
fi
